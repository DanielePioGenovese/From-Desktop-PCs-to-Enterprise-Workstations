source "https://rubygems.org"

# Pinned on purpose: the site is built by GitHub Actions, not by the legacy
# github-pages gem, so we are free of its Jekyll 3.9 constraint and can use the
# Jekyll 4 + just-the-docs combination that the theme actually tests against.
gem "jekyll", "~> 4.3"
gem "just-the-docs", "0.10.1"
gem "jekyll-seo-tag", "~> 2.8"
gem "jekyll-include-cache", "~> 0.2"
